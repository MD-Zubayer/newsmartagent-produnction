
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

upstream django_backend {
    server backend:8000;
    keepalive 32;
}

upstream nextjs_frontend {
    server frontend:3000;
    keepalive 16;
}

upstream flower_backend {
    server flower:5555;
}

upstream minio_api {
    server minio:9000;
}

upstream minio_console {
    server minio:9001;
}

# 🔒 কমন সিকিউরিটি হেডার্স (Global Injection Shield)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
server {
    listen 80;
    client_max_body_size 20M;
    resolver 127.0.0.11 valid=30s;
    server_name ${MAIN_DOMAIN};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # ১. Django Static Files (এটি মাস্ট লাগবেই)
    location /static/ {
        alias /app/static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        
    }

    # ২. Django Media Files
    location /media/ {
        alias /app/media/;  # এনজিনেক্স সরাসরি ভলিউম থেকে ছবি নিবে
    expires 30d;
    add_header Cache-Control "public, no-transform";
    }

    # Django Admin
    location /admin/ {
        proxy_pass http://django_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme; 
        proxy_redirect off;
    }

    # Django Accounts
    location /accounts/ {
        proxy_pass http://django_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django API
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay; # বট বোম্বিং আটকানোর জন্য রেট লিমিট যুক্ত
        proxy_pass http://django_backend;
        proxy_http_version 1.1;       # Keepalive এর জন্য HTTP 1.1 দরকার
        proxy_set_header Connection ""; # ডিফল্ট "close" হেডার মুছে ফেলতে হবে
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location /ws/ {
        proxy_pass http://django_backend; 
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade"; 
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 🔥 এই লাইনটি মাস্ট! এটিই কুকি চুরি হওয়া আটকাবে
        proxy_set_header Cookie $http_cookie;

        # কানেকশন জ্যান্ত রাখতে
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 86400s; # এটিও যোগ করুন
        proxy_redirect off;
    }

    # Next.js Frontend (widget.js is served from Next.js public/ folder)
    location / {
        proxy_pass http://nextjs_frontend;
        
        # রাইট স্ক্রল এবং বড় ডেটা স্ট্রিম করার জন্য
        proxy_buffering off;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    

}


server {
        listen 80;
        server_name ${FLOWER_DOMAIN}; # সাবডোমেন মাস্ট

        location ~ ^/flower/(static|assets)/ {
            proxy_pass http://flower_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Script-Name /flower;
        }

        location / {
            proxy_pass http://flower_backend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https; 

            proxy_redirect off;
            proxy_set_header X-Script-Name /flower; 
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
        }
    }

server {
    listen 80;
    server_name ${MINIO_CONSOLE_DOMAIN};

    location / {
        proxy_pass http://minio_console;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support for MinIO console
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name ${MINIO_API_DOMAIN};

    # Allow large uploads
    client_max_body_size 10M;

    location / {
        proxy_pass http://minio_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

